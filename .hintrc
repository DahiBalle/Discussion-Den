{
  "extends": [
    "development"
  ],
  "hints": {
    "compat-api/css": [
      "default",
      {
        "ignore": [
          "backdrop-filter",
          "user-select"
        ]
      }
    ],
    "axe/name-role-value": [
      "default",
      {
        "button-name": "off",
        "link-name": "off"
      }
    ],
    "axe/structure": [
      "default",
      {
        "list": "off",
        "listitem": "off"
      }
    ],
    "no-inline-styles": "off",
    "axe/forms": [
      "default",
      {
        "select-name": "off"
      }
    ],
    "css-prefix-order": "off",
    "axe/aria": [
      "default",
      {
        "aria-required-children": "off"
      }
    ],
    "axe/text-alternatives": [
      "default",
      {
        "document-title": "off"
      }
    ],
    "axe/language": [
      "default",
      {
        "html-has-lang": "off"
      }
    ],
    "meta-viewport": "off",
    "meta-charset-utf-8": "off"
  },
  "browserslist": [
    "defaults",
    "not ie 11",
    "not and_chr <= 144",
    "not and_ff <= 147",
    "not chrome <= 144",
    "not edge <= 144",
    "not firefox <= 147",
    "not ios_saf <= 26.2",
    "not opera <= 125",
    "not safari <= 26.2",
    "not samsung <= 29"
  ]
}